generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  tasks         Task[]
  categories    Category[]
  tags          Tag[]
  goals         Goal[]
  pomodoroSessions PomodoroSession[]
  settings      UserSettings?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Task {
  id              String    @id @default(cuid())
  title           String
  description     String?
  date            DateTime
  startTime       String?
  endTime         String?
  duration        Int?
  priority        String    @default("medium")
  status          String    @default("not_started")
  color           String?
  isFavorite      Boolean   @default(false)
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  recurringType   String?
  recurringEnd    DateTime?
  reminderMinutes Int?
  notes           String?
  order           Int       @default(0)
  userId          String
  categoryId      String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags            TaskTag[]
  subtasks        Subtask[]
  checklists      Checklist[]
  attachments     Attachment[]
  history         TaskHistory[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, date])
  @@index([userId, status])
  @@index([userId, categoryId])
  @@map("tasks")
}

model Category {
  id        String  @id @default(cuid())
  name      String
  color     String  @default("#6366f1")
  icon      String  @default("folder")
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@map("categories")
}

model Tag {
  id     String    @id @default(cuid())
  name   String
  color  String    @default("#64748b")
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  TaskTag[]
  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@map("tags")
}

model TaskTag {
  taskId String
  tagId  String
  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

model Subtask {
  id        String  @id @default(cuid())
  title     String
  completed Boolean @default(false)
  order     Int     @default(0)
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("subtasks")
}

model Checklist {
  id        String  @id @default(cuid())
  title     String
  checked   Boolean @default(false)
  order     Int     @default(0)
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("checklists")
}

model Attachment {
  id        String  @id @default(cuid())
  filename  String
  path      String
  mimetype  String?
  size      Int?
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("attachments")
}

model TaskHistory {
  id        String  @id @default(cuid())
  action     String
  field      String?
  oldValue   String?
  newValue   String?
  taskId     String
  task       Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@map("task_history")
}

model Goal {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String
  target      Int
  current     Int      @default(0)
  startDate   DateTime
  endDate     DateTime
  completed   Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("goals")
}

model PomodoroSession {
  id        String   @id @default(cuid())
  duration  Int
  type      String
  taskId    String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime @default(now())
  endedAt   DateTime?

  @@map("pomodoro_sessions")
}

model UserSettings {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme           String  @default("system")
  defaultView     String  @default("month")
  startOfWeek     Int     @default(0)
  pomodoroWork    Int     @default(25)
  pomodoroBreak   Int     @default(5)
  pomodoroLong    Int     @default(15)
  notificationsOn Boolean @default(true)
  language        String  @default("pt-BR")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("user_settings")
}
